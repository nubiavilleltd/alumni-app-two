# Alumni Portal frontend environment template (names only — no secrets).
# Copy to `.env.local` and fill in values for local development.

# ── API ──────────────────────────────────────────────────────────────────────
# Base URL of the FastAPI backend. Leave empty to use same-origin (Vite proxy).
VITE_API_BASE_URL=
# Legacy reusable application key header (ignored by the FastAPI backend).
VITE_API_TOKEN=

# ── Blog / content API ───────────────────────────────────────────────────────
VITE_CONTENT_API_BASE_URL=
VITE_CONTENT_API_TOKEN=

# ── Payments ─────────────────────────────────────────────────────────────────
# Paystack public key for the inline payment widget (test or live).
VITE_PAYSTACK_PUBLIC_KEY=

# ── Social login ─────────────────────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=

# ── Firebase (event registration survey, historical only) ───────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_FUNCTIONS_REGION=
VITE_FIREBASE_FUNCTIONS_BASE_URL=
